{
  "name": "donkeytv-desktop",
  "version": "1.1.0",
  "description": "Donkey TV for Windows",
  "main": "main.js",
  "author": "Domi7392101",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "to.donkey.tv",
    "productName": "Donkey TV",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../app/src/main/assets", "to": "assets" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Donkey TV"
    },
    "portable": { "artifactName": "DonkeyTV-portable-${version}.exe" }
  }
}
