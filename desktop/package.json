{
  "name": "donkeytv-desktop",
  "version": "1.2.0",
  "description": "Donkey TV for Windows",
  "main": "main.js",
  "author": "Domi7392101",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "to.donkey.tv",
    "productName": "Donkey TV",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "pc.css", "package.json"],
    "extraResources": [{ "from": "../app/src/main/assets", "to": "assets" }],
    "publish": [
      {
        "provider": "github",
        "owner": "Domi7392101",
        "repo": "DonkeyTV",
        "releaseType": "release"
      }
    ],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Donkey TV"
    }
  }
}
